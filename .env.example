# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# .env.example is a BLANK template — real secrets go only in your local .env.

# --- Tenants: bootstrap seed "tenantId:apiKey" comma-separated ---
# On startup these are UPSERTED into the Postgres `tenants` table with the key stored
# as a sha256 HASH (never plaintext). Auth then validates X-API-Key against the DB.
# REQUIRED — there is NO default. Use a HIGH-ENTROPY random key, e.g.:
#   TENANT_KEYS=demo:$(python3 -c "import secrets;print(secrets.token_urlsafe(32))")
TENANT_KEYS=

# --- Chat LLM (Groq, OpenAI-compatible; free tier) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
# Swap to OpenAI with ZERO code change:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- Embeddings (Google Gemini text-embedding-004, 768-dim) ---
# Default uses Gemini's OpenAI-compatible endpoint via the openai client.
# If that shape proves unreliable, set EMBED_PROVIDER=gemini to use the google-genai SDK.
EMBED_PROVIDER=openai
EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBED_API_KEY=
EMBED_MODEL=text-embedding-004
EMBED_DIM=768

# --- Database (Supabase Postgres; holds pgvector chunks + relational tables) ---
# Supabase -> Project Settings -> Database -> Connection string (URI). Use the
# session/pooler URI. Example: postgresql://postgres:PASS@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=
# Read-only role for secured Chat-to-SQL (create it via supabase_setup.sql).
# NO fallback: if unset, Chat-to-SQL is DISABLED (it will NOT run on the write role).
# Point at a SELECT-only role, e.g. the vela_readonly role from supabase_setup.sql.
READONLY_DATABASE_URL=

# --- Security ---
PII_REDACTION=true
RATE_LIMIT_PER_MIN=30

# --- Retrieval / anti-hallucination ---
TOP_K=5
MIN_SCORE=0.35          # cosine similarity threshold [0..1]; below => "I don't know" deflection

# --- Chat-to-SQL guardrails ---
SQL_ROW_CAP=100
SQL_TIMEOUT_MS=3000

# --- Observability (optional) ---
LANGFUSE_ENABLED=false
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
AUDIT_LOG_PATH=data/audit.log.jsonl

# --- DEPRECATED (old local stack; no longer used) ---
# QDRANT_URL / QDRANT_API_KEY  -> replaced by Supabase pgvector
# Ollama LLM_BASE_URL          -> replaced by Groq

# --- Admin portal ---
# Gates /admin (X-Admin-Token). REQUIRED to enable the portal; no default.
ADMIN_TOKEN=

# --- Infrastructure / Cloudflare (optional) ---
# Set BOTH to show live Cloudflare Pages/Workers counts on the admin Infrastructure page.
# Token needs read access to Pages + Workers Scripts. Leave blank to keep it "not connected".
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
